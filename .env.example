[TEMPLATE]
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# MASTER_PASSWORD: senha do Administrador Principal (superadmin).
# Nunca versionar o arquivo .env real. Se esta variável não existir,
# o servidor gera uma senha aleatória por execução e a imprime no console.
MASTER_PASSWORD="defina-uma-senha-forte"

# AUTH_SECRET: chave HMAC que assina os tokens de sessão.
# Sem ela, um segredo aleatório é gerado a cada boot (todas as sessões caem no restart).
AUTH_SECRET="gere-um-valor-aleatorio-de-64-caracteres"

# TRUST_PROXY: defina como "true" SOMENTE quando a aplicação estiver atrás de um
# proxy reverso confiável que sobrescreve X-Forwarded-For. Caso contrário, o IP
# real da conexão é usado no rate limiting (evita bypass por header falsificado).
TRUST_PROXY="false"

# PORT: porta HTTP do servidor Express/Vite.
PORT="3000"
